# .env.example - Template for environment variables
# Copy this file to .env and update the values

# ============================================
# GENERAL
# ============================================
NODE_ENV=production

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-this-secure-password

# ============================================
# STRAPI SECRETS (Generate new secrets!)
# ============================================
# Generate secrets:
#   Linux/Mac: openssl rand -base64 32
#   Windows PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_SECRET=change-this-jwt-secret
ADMIN_JWT_SECRET=change-this-admin-jwt-secret
APP_KEYS=change-this-app-keys
API_TOKEN_SALT=change-this-api-token-salt
TRANSFER_TOKEN_SALT=change-this-transfer-token-salt
ENCRYPTION_KEY=change-this-encryption-key

# ============================================
# FRONTEND (Next.js)
# ============================================
# For production, use your actual domain
NEXT_PUBLIC_API_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For production with Nginx reverse proxy:
# NEXT_PUBLIC_API_URL=https://yourdomain.com
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ============================================
# OPTIONAL
# ============================================
# SMTP for email (optional)
# EMAIL_PROVIDER=sendgrid
# EMAIL_FROM=noreply@bephue.vn
# EMAIL_TO=admin@bephue.vn
# SENDGRID_API_KEY=your-sendgrid-api-key

# AWS S3 for media storage (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-southeast-1
# AWS_BUCKET=bephue-media
