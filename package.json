{
  "name": "bephue-restaurant",
  "version": "1.0.0",
  "description": "Full-stack restaurant website for BepHue - Vietnamese Hue cuisine",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run develop",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start:frontend": "cd frontend && npm run start",
    "start:backend": "cd backend && npm run start",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "lint": "npm-run-all lint:frontend lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint"
  },
  "keywords": [
    "restaurant",
    "nextjs",
    "strapi",
    "typescript",
    "tailwindcss"
  ],
  "author": "BepHue Restaurant",
  "license": "UNLICENSED",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
