# backend/.dockerignore

# ============================================
# Dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ============================================
# Build output & Cache
# ============================================
.cache/
build/
dist/
.tmp/
.strapi/
.strapi-updater.json
exports/

# ============================================
# Environment files
# ============================================
.env*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# Database files (will be in Docker volume)
# ============================================
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
data.db
database.sqlite

# ============================================
# Uploads (will be in Docker volume)
# ============================================
# Uncomment if you want to exclude uploads from build context
# public/uploads/
# uploads/

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ============================================
# OS files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# ============================================
# IDE & Editors
# ============================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.atom/
.project
.classpath
.settings/
*.launch
.vs/

# ============================================
# Git
# ============================================
.git/
.gitignore
.gitattributes
.gitmodules

# ============================================
